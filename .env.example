# Supabase project URL (Project Settings -> API). Public value.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon / publishable key. Public by design: row level security is the boundary.
# Never put the service_role key here or anywhere in this repository.
VITE_SUPABASE_ANON_KEY=
# Base path the site is served from: "/" for a custom domain, "/<repo>/" for a github.io project page.
VITE_BASE_PATH=/
# Public address of the site, without a trailing slash: used for the canonical URL, link previews,
# robots.txt and sitemap.xml. Defaults to https://vi-mp.ro. For a github.io project page use
# https://<user>.github.io/<repo>
VITE_SITE_URL=https://vi-mp.ro
